{
  "manifest_version": 3,
  "name": "Schola Thomistica — Latin Reader",
  "short_name": "ScholaThom",
  "version": "1.2.0",
  "minimum_chrome_version": "111",
  "description": "Interactive Latin reader for Corpus Thomisticum with 5 dictionaries, bilingual gloss, and FSRS vocabulary review.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.corpusthomisticum.org/*",
    "http://www.corpusthomisticum.org/*",
    "https://corpusthomisticum.org/*",
    "http://corpusthomisticum.org/*",
    "https://*.corpusthomisticum.org/*",
    "http://*.corpusthomisticum.org/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Schola Thomistica — Latin Reader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.corpusthomisticum.org/*",
        "http://www.corpusthomisticum.org/*",
        "https://corpusthomisticum.org/*",
        "http://corpusthomisticum.org/*",
        "https://*.corpusthomisticum.org/*",
        "http://*.corpusthomisticum.org/*",
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": ["neutralize-perseus.js"],
      "world": "MAIN",
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.corpusthomisticum.org/*",
        "http://www.corpusthomisticum.org/*",
        "https://corpusthomisticum.org/*",
        "http://corpusthomisticum.org/*",
        "https://*.corpusthomisticum.org/*",
        "http://*.corpusthomisticum.org/*",
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "study/study.html",
        "study/study.js",
        "styles/content.css",
        "data/*.json",
        "icons/*.png"
      ],
      "matches": [
        "https://www.corpusthomisticum.org/*",
        "http://www.corpusthomisticum.org/*",
        "https://corpusthomisticum.org/*",
        "http://corpusthomisticum.org/*",
        "https://*.corpusthomisticum.org/*",
        "http://*.corpusthomisticum.org/*",
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ]
    }
  ]
}
